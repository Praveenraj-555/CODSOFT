<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Landing Page</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #f0f4f8;
      color: #333;
      line-height: 1.6;
    }

    header {
      background-color: #0d47a1;
      color: white;
      padding: 60px 20px;
      text-align: center;
    }

    header h1 {
      font-size: 3em;
    }

    header p {
      font-size: 1.2em;
    }

    .container {
      padding: 40px 20px;
      max-width: 1100px;
      margin: auto;
    }

    .columns {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 30px;
    }

    .box {
      background-color: white;
      flex: 1 1 300px;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      transition: transform 0.2s ease;
    }

    .box:hover {
      transform: translateY(-5px);
    }

    .box h3 {
      margin-bottom: 10px;
      color: #0d47a1;
    }

    .cta {
      background-color: #1976d2;
      color: white;
      padding: 30px 20px;
      text-align: center;
      margin: 40px 0;
      border-radius: 10px;
    }

    .cta a {
      background-color: white;
      color: #1976d2;
      padding: 12px 25px;
      text-decoration: none;
      font-weight: bold;
      border-radius: 5px;
      margin-top: 10px;
      display: inline-block;
    }

    footer {
      text-align: center;
      padding: 20px;
      background-color: #0d47a1;
      color: white;
    }

    @media (max-width: 768px) {
      header h1 {
        font-size: 2em;
      }
      .columns {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>

  <!-- Header Section -->
  <header>
    <h1>Welcome to My Landing Page</h1>
    <p>Learn. Build. Grow.</p>
  </header>

  <!-- Content Section -->
  <div class="container"> 
    <h2 style="text-align: center;">Why Choose Us?</h2>
    <div class="columns">
      <div class="box">
        <h3>Easy to Learn</h3>
        <p>We make web development easy for beginners with step-by-step guides.</p>
      </div>
      <div class="box">
        <h3>Creative Designs</h3>
        <p>Explore your creativity with beautiful and responsive layouts.</p>
      </div>
      <div class="box">
        <h3>Practical Projects</h3>
        <p>Hands-on projects help you build confidence and real-world skills.</p>
      </div>
    </div>
  </div>

  <!-- Call to Action Section -->
  <div class="cta">
    <h2>Start Your Journey Today</h2>
    <p>Build something awesome with just HTML & CSS</p>
    <a href="#">Get Started</a>
  </div>

  <!-- Footer -->
  <footer>
    &copy; 2025 My Landing Page. All rights reserved.
  </footer>

</body>
</html>
